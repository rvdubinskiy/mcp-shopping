{
  "name": "mcp-shopping",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for searching and visualizing Turkish shopping results from Yandex Shopping.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "client": "node dist/client.js",
    "dev:server": "tsx src/server.ts",
    "dev:client": "tsx src/client.ts"
  },
  "keywords": [
    "mcp",
    "yandex",
    "shopping",
    "turkey"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "cheerio": "^1.0.0-rc.12",
    "undici": "^6.19.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/cheerio": "^0.22.35",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "tsx": "^4.7.1",
    "typescript": "^5.5.4"
  }
}
